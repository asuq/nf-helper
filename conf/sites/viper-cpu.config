profiles {
    'viper-cpu' {
        params {
            config_profile_description = 'MPCDF Viper-CPU profile with Slurm compute jobs and bounded login-node downloads.'
            config_profile_contact = 'Akito Shima'
            config_profile_url = 'https://docs.mpcdf.mpg.de/doc/computing/viper-user-guide.html'

            max_memory = 2250000.MB
            max_cpus = 128
            max_time = 24.h
            viper_slurm_queue_size = 250
            apptainer_cache_dir = {
                def viperLaunchHost = (env('HOSTNAME') ?: '').toString().toLowerCase()
                def viperLaunchHostShort = viperLaunchHost.tokenize('.')[0]
                def viperCacheDir = params.apptainer_cache_dir ?: env('NXF_APPTAINER_CACHEDIR')

                if (viperLaunchHostShort != 'viper05' && viperLaunchHostShort != 'viper05i') {
                    throw new IllegalArgumentException(
                        "The viper-cpu profile must be launched from viper05i (HOSTNAME viper05 or viper05i); detected '${viperLaunchHost ?: 'unknown'}'."
                    )
                }
                if (!viperCacheDir) {
                    throw new IllegalArgumentException(
                        'Set NXF_APPTAINER_CACHEDIR to a shared /ptmp path or provide --apptainer_cache_dir.'
                    )
                }
                if (!viperCacheDir.toString().startsWith('/ptmp/')) {
                    throw new IllegalArgumentException(
                        "The Viper Apptainer cache must be under /ptmp; detected '${viperCacheDir}'."
                    )
                }

                viperCacheDir
            }()
            viper_apptainer_module = 'apptainer/1.4.3'
        }

        cleanup = false

        process {
            executor = 'slurm'
            clusterOptions = '--export=ALL'
            scratch = false
            stageOutMode = 'copy'
            resourceLimits = [
                memory: 2250000.MB,
                cpus: 128,
                time: 24.h,
            ]
            beforeScript = {
                "module load ${params.viper_apptainer_module}"
            }

            withLabel: needs_internet {
                executor = 'local'
                cpus = 1
                memory = 16.GB
                time = 24.h
                scratch = false
                resourceLimits = [
                    memory: 16.GB,
                    cpus: 1,
                    time: 24.h,
                ]
            }

            withLabel: process_local_scratch {
                scratch = '$JOB_TMPDIR'
                stageOutMode = 'copy'
            }
        }

        executor {
            $slurm {
                queueSize = params.viper_slurm_queue_size as int
                pollInterval = '30 sec'
                queueStatInterval = '30 sec'
                exitReadTimeout = '1 min'
                submitRateLimit = '5/1s'
                perCpuMemAllocation = false
            }

            $local {
                cpus = 2
                memory = 32.GB
            }
        }

        singularity {
            enabled = false
        }

        apptainer {
            enabled = true
            autoMounts = true
            ociAutoPull = false
            cacheDir = params.apptainer_cache_dir
            pullTimeout = '4h'
        }

        docker {
            enabled = false
        }

        conda {
            enabled = false
        }
    }
}
