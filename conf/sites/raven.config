profiles {
    raven {
        params {
            config_profile_description = 'MPCDF Raven profile with Slurm CPU/GPU jobs and bounded login-node downloads.'
            config_profile_contact = 'Akito Shima'
            config_profile_url = 'https://docs.mpcdf.mpg.de/doc/computing/raven-user-guide.html'

            // Ordinary tasks use physical cores. Processes that explicitly
            // enable Raven hyperthreading may use raven_max_cpus_ht instead.
            max_memory = 2048000.MB
            max_cpus = 72
            max_time = 24.h
            raven_max_cpus_ht = 144
            raven_slurm_queue_size = 250
            raven_gpu_constraint = 'gpu'
            gpus = 1
            gpu_cluster_options = null
            apptainer_run_options = '--cleanenv'
            gpu_container_options = '--nv'
            singularity_run_options = null
            apptainer_cache_dir = {
                def ravenLaunchHost = (env('HOSTNAME') ?: '').toString().toLowerCase()
                def ravenLaunchHostShort = ravenLaunchHost.tokenize('.')[0]
                def validRavenHosts = [
                    'raven01', 'raven01i',
                    'raven02', 'raven02i',
                    'raven03', 'raven03i',
                    'raven04', 'raven04i',
                ]
                def ravenCacheDir = params.apptainer_cache_dir ?: env('NXF_APPTAINER_CACHEDIR')

                if (!validRavenHosts.contains(ravenLaunchHostShort)) {
                    throw new IllegalArgumentException(
                        "The raven profile must be launched from an explicit Raven login node raven01i-raven04i; detected '${ravenLaunchHost ?: 'unknown'}'."
                    )
                }
                if (!ravenCacheDir) {
                    throw new IllegalArgumentException(
                        'Set NXF_APPTAINER_CACHEDIR to a shared /ptmp path or provide --apptainer_cache_dir.'
                    )
                }
                if (!ravenCacheDir.toString().startsWith('/ptmp/')) {
                    throw new IllegalArgumentException(
                        "The Raven Apptainer cache must be under /ptmp; detected '${ravenCacheDir}'."
                    )
                }

                ravenCacheDir
            }()
            raven_gpu_request = {
                def gpuCount = params.gpus as int
                def gpuConstraint = params.raven_gpu_constraint.toString()
                def validGpuCounts = [1, 2, 4]
                def validGpuConstraints = ['gpu', 'gpu-bw', 'no-gpu-bw']

                if (!validGpuCounts.contains(gpuCount)) {
                    throw new IllegalArgumentException(
                        "Raven GPU jobs require --gpus 1, 2, or 4; detected '${params.gpus}'."
                    )
                }
                if (!validGpuConstraints.contains(gpuConstraint)) {
                    throw new IllegalArgumentException(
                        "Raven --raven_gpu_constraint must be gpu, gpu-bw, or no-gpu-bw; detected '${gpuConstraint}'."
                    )
                }

                "--constraint=\"${gpuConstraint}\" --gres=gpu:a100:${gpuCount}"
            }()
            raven_apptainer_module = 'apptainer/1.4.3'
        }

        cleanup = false

        process {
            executor = 'slurm'
            clusterOptions = '--export=ALL'
            scratch = false
            stageOutMode = 'copy'
            resourceLimits = [
                memory: 2048000.MB,
                cpus: 72,
                time: 24.h,
            ]
            beforeScript = {
                "module load ${params.raven_apptainer_module}"
            }

            withLabel: needs_internet {
                executor = 'local'
                cpus = 1
                memory = 16.GB
                time = 24.h
                scratch = false
                resourceLimits = [
                    memory: 16.GB,
                    cpus: 1,
                    time: 24.h,
                ]
            }

            withLabel: process_local_scratch {
                scratch = '$JOB_TMPDIR'
                stageOutMode = 'copy'
            }

            withLabel: gpu {
                cpus = { 18 * (params.gpus as int) }
                resourceLimits = [
                    memory: 125000.MB * (params.gpus as int),
                    cpus: 18 * (params.gpus as int),
                    time: 24.h,
                ]
                clusterOptions = {
                    [
                        '--export=ALL',
                        params.raven_gpu_request,
                        params.gpu_cluster_options ?: null,
                    ]
                        .findAll { option -> option != null && option.toString().trim() }
                        .join(' ')
                }
                containerOptions = {
                    [
                        (params.apptainer_run_options ?: params.singularity_run_options ?: '').toString() ?: null,
                        params.gpu_container_options ?: '--nv',
                    ]
                        .findAll { option -> option != null && option.toString().trim() }
                        .join(' ')
                }
            }
        }

        executor {
            $slurm {
                queueSize = params.raven_slurm_queue_size as int
                pollInterval = '30 sec'
                queueStatInterval = '30 sec'
                exitReadTimeout = '1 min'
                submitRateLimit = '5/1s'
                perCpuMemAllocation = false
            }

            $local {
                cpus = 2
                memory = 32.GB
            }
        }

        singularity {
            enabled = false
        }

        apptainer {
            enabled = true
            autoMounts = true
            ociAutoPull = false
            cacheDir = params.apptainer_cache_dir
            pullTimeout = '4h'
            runOptions = params.apptainer_run_options
        }

        docker {
            enabled = false
        }

        conda {
            enabled = false
        }
    }
}
