profiles {
    gwdg {
        params {
            gwdg_default_container_cache_dir = '/projects/scc/MPG/MBMM/scc_mbmm_harder_/dir.project/Softwares/nfx_singularity_cache'
            gwdg_proxy_url = 'http://www-cache.gwdg.de:3128'
            config_profile_description = 'The GWDG SCC HPC profile with SLURM, Apptainer/Singularity, and SHM-first temporary storage.'
            config_profile_contact = 'GWDG SCC user profile'
            config_profile_url = 'https://docs.hpc.gwdg.de/how_to_use/storage_systems/temporary_storage/index.html'
            max_memory = 2.TB
            max_cpus = 96
            max_time = 48.h
            queue_short = 'scc-cpu,medium'
            queue_standard = 'scc-cpu,medium'
            queue_highmem = 'scc-cpu,medium'
            queue_gpu = 'scc-gpu'
            slurm_queue = null
            slurm_cluster_options = null
            gpu_cluster_options = null
            gpu_type = null
            gpus = 1
            gpu_container_options = '--nv'
            executor_queue_size = null
            executor_exit_read_timeout = '180 min'
            singularity_cache_dir = '/projects/scc/MPG/MBMM/scc_mbmm_harder_/dir.project/Softwares/nfx_singularity_cache'
            singularity_run_options = null
            singularity_pull_timeout = '4h'
            apptainer_cache_dir = null
            apptainer_run_options = null
            apptainer_pull_timeout = null
        }

        process {
            executor = 'slurm'
            queue = params.slurm_queue ?: params.queue_standard
            clusterOptions = {
                [
                    '--export=ALL',
                    '-C ssd',
                    params.slurm_cluster_options ?: null,
                ]
                    .findAll { option -> option != null && option.toString().trim() }
                    .join(' ')
            }
            resourceLimits = [
                memory: 2.TB,
                cpus: 96,
                time: 48.h,
            ]
            containerOptions = {
                [
                    (params.apptainer_run_options ?: params.singularity_run_options ?: '').toString() ?: null,
                ]
                    .findAll { option -> option != null && option.toString().trim() }
                    .join(' ')
            }
            scratch = '$LOCAL_TMPDIR'
            stageOutMode = 'copy'
            beforeScript = {
                def tempRoot = (task.attempt as int) == 1
                    ? '${SHM_TMPDIR:-${LOCAL_TMPDIR:-${SHARED_SSD_TMPDIR:-${SHARED_TMPDIR:-/tmp}}}}'
                    : '${LOCAL_TMPDIR:-${SHARED_SSD_TMPDIR:-${SHARED_TMPDIR:-/tmp}}}'
                def cacheDir = (params.apptainer_cache_dir ?: params.singularity_cache_dir ?: params.gwdg_default_container_cache_dir).toString()

                [
                    'module load apptainer',
                    "temp_root=\"${tempRoot}\"",
                    "container_cache=\"${cacheDir}\"",
                    'mkdir -p "${container_cache}"',
                    'export TMPDIR="${temp_root}"',
                    'export TMP="${temp_root}"',
                    'export TEMP="${temp_root}"',
                    'export TEMPDIR="${temp_root}"',
                    'export APPTAINER_CACHEDIR="${container_cache}"',
                    'export SINGULARITY_CACHEDIR="${container_cache}"',
                    'export APPTAINER_TMPDIR="${temp_root}"',
                    'export SINGULARITY_TMPDIR="${temp_root}"',
                    'export APPTAINERENV_TMPDIR="${temp_root}"',
                    'export SINGULARITYENV_TMPDIR="${temp_root}"',
                    'export APPTAINERENV_TMP="${temp_root}"',
                    'export SINGULARITYENV_TMP="${temp_root}"',
                    'export APPTAINERENV_APPTAINER_TMPDIR="${temp_root}"',
                    'export SINGULARITYENV_SINGULARITY_TMPDIR="${temp_root}"',
                    'export APPTAINERENV_APPTAINER_CACHEDIR="${container_cache}"',
                    'export APPTAINERENV_SINGULARITY_CACHEDIR="${container_cache}"',
                    'export SINGULARITYENV_APPTAINER_CACHEDIR="${container_cache}"',
                    'export SINGULARITYENV_SINGULARITY_CACHEDIR="${container_cache}"',
                ].join('\n')
            }

            withLabel: needs_internet {
                clusterOptions = {
                    [
                        '--export=ALL',
                        '-C "ssd&inet"',
                        params.slurm_cluster_options ?: null,
                    ]
                        .findAll { option -> option != null && option.toString().trim() }
                        .join(' ')
                }
                beforeScript = {
                    def tempRoot = (task.attempt as int) == 1
                        ? '${SHM_TMPDIR:-${LOCAL_TMPDIR:-${SHARED_SSD_TMPDIR:-${SHARED_TMPDIR:-/tmp}}}}'
                        : '${LOCAL_TMPDIR:-${SHARED_SSD_TMPDIR:-${SHARED_TMPDIR:-/tmp}}}'
                    def cacheDir = (params.apptainer_cache_dir ?: params.singularity_cache_dir ?: params.gwdg_default_container_cache_dir).toString()

                    [
                        'module load apptainer',
                        "temp_root=\"${tempRoot}\"",
                        "container_cache=\"${cacheDir}\"",
                        'mkdir -p "${container_cache}"',
                        'export TMPDIR="${temp_root}"',
                        'export TMP="${temp_root}"',
                        'export TEMP="${temp_root}"',
                        'export TEMPDIR="${temp_root}"',
                        'export APPTAINER_CACHEDIR="${container_cache}"',
                        'export SINGULARITY_CACHEDIR="${container_cache}"',
                        'export APPTAINER_TMPDIR="${temp_root}"',
                        'export SINGULARITY_TMPDIR="${temp_root}"',
                        'export APPTAINERENV_TMPDIR="${temp_root}"',
                        'export SINGULARITYENV_TMPDIR="${temp_root}"',
                        'export APPTAINERENV_TMP="${temp_root}"',
                        'export SINGULARITYENV_TMP="${temp_root}"',
                        'export APPTAINERENV_APPTAINER_TMPDIR="${temp_root}"',
                        'export SINGULARITYENV_SINGULARITY_TMPDIR="${temp_root}"',
                        'export APPTAINERENV_APPTAINER_CACHEDIR="${container_cache}"',
                        'export APPTAINERENV_SINGULARITY_CACHEDIR="${container_cache}"',
                        'export SINGULARITYENV_APPTAINER_CACHEDIR="${container_cache}"',
                        'export SINGULARITYENV_SINGULARITY_CACHEDIR="${container_cache}"',
                        "export http_proxy=\"${params.gwdg_proxy_url}\"",
                        "export https_proxy=\"${params.gwdg_proxy_url}\"",
                        "export ftp_proxy=\"${params.gwdg_proxy_url}\"",
                        "export HTTP_PROXY=\"${params.gwdg_proxy_url}\"",
                        "export HTTPS_PROXY=\"${params.gwdg_proxy_url}\"",
                        "export FTP_PROXY=\"${params.gwdg_proxy_url}\"",
                        "export APPTAINERENV_http_proxy=\"${params.gwdg_proxy_url}\"",
                        "export APPTAINERENV_https_proxy=\"${params.gwdg_proxy_url}\"",
                        "export APPTAINERENV_ftp_proxy=\"${params.gwdg_proxy_url}\"",
                        "export APPTAINERENV_HTTP_PROXY=\"${params.gwdg_proxy_url}\"",
                        "export APPTAINERENV_HTTPS_PROXY=\"${params.gwdg_proxy_url}\"",
                        "export APPTAINERENV_FTP_PROXY=\"${params.gwdg_proxy_url}\"",
                        "export SINGULARITYENV_http_proxy=\"${params.gwdg_proxy_url}\"",
                        "export SINGULARITYENV_https_proxy=\"${params.gwdg_proxy_url}\"",
                        "export SINGULARITYENV_ftp_proxy=\"${params.gwdg_proxy_url}\"",
                        "export SINGULARITYENV_HTTP_PROXY=\"${params.gwdg_proxy_url}\"",
                        "export SINGULARITYENV_HTTPS_PROXY=\"${params.gwdg_proxy_url}\"",
                        "export SINGULARITYENV_FTP_PROXY=\"${params.gwdg_proxy_url}\"",
                    ].join('\n')
                }
            }

            withLabel: gpu {
                queue = params.queue_gpu
                clusterOptions = {
                    [
                        '--export=ALL',
                        '-C ssd',
                        params.gpu_type
                            ? "--gpus=${params.gpu_type}:${params.gpus ?: 1}"
                            : "--gpus=${params.gpus ?: 1}",
                        params.slurm_cluster_options ?: null,
                        params.gpu_cluster_options ?: null,
                    ]
                        .findAll { option -> option != null && option.toString().trim() }
                        .join(' ')
                }
                containerOptions = {
                    [
                        (params.apptainer_run_options ?: params.singularity_run_options ?: '').toString() ?: null,
                        params.gpu_container_options ?: '--nv',
                    ]
                        .findAll { option -> option != null && option.toString().trim() }
                        .join(' ')
                }
            }
        }

        executor {
            queueSize = params.executor_queue_size ?: 2000
            exitReadTimeout = params.executor_exit_read_timeout
        }

        singularity {
            enabled = false
            autoMounts = true
            cacheDir = (params.apptainer_cache_dir ?: params.singularity_cache_dir ?: params.gwdg_default_container_cache_dir).toString()
            runOptions = (params.apptainer_run_options ?: params.singularity_run_options ?: '').toString()
            pullTimeout = params.apptainer_pull_timeout ?: params.singularity_pull_timeout ?: '4h'
        }

        apptainer {
            enabled = true
            autoMounts = true
            ociAutoPull = true
            cacheDir = (params.apptainer_cache_dir ?: params.singularity_cache_dir ?: params.gwdg_default_container_cache_dir).toString()
            runOptions = (params.apptainer_run_options ?: params.singularity_run_options ?: '').toString()
            pullTimeout = params.apptainer_pull_timeout ?: params.singularity_pull_timeout ?: '4h'
        }

        docker {
            enabled = false
        }
    }
}
